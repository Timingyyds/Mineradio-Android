{
  "appId": "Mineradio.timing",
  "appName": "Mineradio",
  "webDir": "public",
  "backgroundColor": "#09090b",
  "android": {
    "allowMixedContent": true
  },
  "server": {
    "androidScheme": "https",
    "hostname": "localhost",
    "cleartext": false
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "launchShowDuration": 900,
      "backgroundColor": "#09090b",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "DARK",
      "backgroundColor": "#09090b"
    }
  },
  "loggingBehavior": "verbose"
}
