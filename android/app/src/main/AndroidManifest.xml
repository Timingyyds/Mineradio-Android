<?xml version="1.0" encoding="utf-8" ?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 明确声明支持大屏与任意密度，减少厂商兼容模式把 App 塞进固定比例窗口的概率。 -->
    <supports-screens
        android:anyDensity="true"
        android:largeScreens="true"
        android:normalScreens="true"
        android:resizeable="true"
        android:smallScreens="true"
        android:xlargeScreens="true" />

    <application
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/AppTheme">
        <!-- ColorOS 原生锁屏歌词：声明本应用愿意进 OPlus 的媒体历史 / 媒体管线。 -->
        <meta-data
            android:name="io.github.andrealtb.lockscreenlyrics.OPLUS_MEDIA_HISTORY"
            android:value="true" />
        <service
            android:name=".FoliaPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />
        <!-- MPKG/视频/HTML/图片壁纸：独立进程，主进程被杀也不死 -->
        <service
            android:name=".wallpaper.LWService"
            android:enabled="true"
            android:exported="true"
            android:label="@string/wallpaper_service_label"
            android:permission="android.permission.BIND_WALLPAPER">
            <intent-filter>
                <action android:name="android.service.wallpaper.WallpaperService" />
            </intent-filter>
            <meta-data
                android:name="android.service.wallpaper"
                android:resource="@xml/livewallpaper" />
        </service>
        <receiver
            android:name=".PlaybackActionReceiver"
            android:exported="false" />
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="landscape"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ════════════════════════════════════════════════════════════
             ★ 壁纸相关组件（移植自原生工程 mineraido-android 的 AndroidManifest）
             之前这些组件一个都没声明，导致：
               1) 设为系统壁纸后 LWService 虽然被绑定，但 KeepAlive / 断线自恢复链全断；
               2) MpkgPreviewActivity 无法启动（ActivityNotFoundException）；
               3) BootReceiver 收不到开机广播，重启后壁纸不恢复。
             ════════════════════════════════════════════════════════════ -->

        <!-- MPKG 场景壁纸预览 Activity：MpkgWallpaperPlugin / 前端预览入口 -->
        <activity
            android:name=".wallpaper.MpkgPreviewActivity"
            android:enabled="true"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- 壁纸保活前台服务：LWService.onCreate 第一件事就是启动它 -->
        <service
            android:name=".wallpaper.WallpaperKeepAliveService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_TYPE_SUBSYSTEM"
                android:value="wallpaper_keep_alive" />
        </service>

        <!-- 桌面萌宠悬浮窗服务（WindowManager 悬浮窗，独立于系统壁纸） -->
        <service
            android:name=".wallpaper.PetFloatingService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_TYPE_SUBSYSTEM"
                android:value="pet_floating" />
        </service>

        <!-- 开机自启动：重启后自动恢复壁纸服务 -->
        <receiver
            android:name=".wallpaper.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- 壁纸刷新接收器：收到 ACTION_REFRESH 拉起 KeepAlive 服务 -->
        <receiver
            android:name=".wallpaper.WallpaperReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.mineradio.wallpaper.ACTION_REFRESH" />
                <action android:name="com.mineradio.wallpaper.ACTION_TEST" />
            </intent-filter>
        </receiver>

        <!-- 系统壁纸被切换走时立刻触发恢复 -->
        <receiver
            android:name=".wallpaper.WallpaperChangeReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.WALLPAPER_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- JobScheduler 持久化兜底 -->
        <service
            android:name=".wallpaper.WallpaperJobService"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <!-- AlarmManager 唤醒接收器（进程被清理后的重试链） -->
        <receiver
            android:name=".wallpaper.WallpaperAlarmReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.mineradio.wallpaper.ACTION_WAKEUP" />
            </intent-filter>
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/file_paths" />
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />

    <!-- ══ 壁纸功能所需权限 ══ -->
    <!-- 设为系统静态壁纸（WallpaperHelper.setBitmap / setImageAsSystemWallpaper） -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />
    <uses-permission android:name="android.permission.SET_WALLPAPER_HINTS" />
    <!-- 开机/更新后恢复壁纸 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- 场景壁纸音频可视化（Visualizer(0) 捕获系统混音，LWService.startAudio） -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- 保活前台服务：targetSdk 34+ 必须声明对应类型，否则 startForeground 抛
         MissingForegroundServiceTypeException -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- 保活心跳/重启（WallpaperAlarmReceiver） -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SET_ALARM" />
    <!-- 桌面萌宠悬浮窗（PetFloatingService） -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
</manifest>
